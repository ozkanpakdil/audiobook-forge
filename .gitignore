# Generated audio: never committed, everyone builds their own.
# Every book keeps its MP3s in books/<slug>/audio/.
*.mp3
*.wav
audio/
books/*/audio/
*.m3u

# Intermediate WAV chunks kept for resuming a run.
.cache/

# Downloaded speech models and the tool environment.
models/
.tools/
.venv/
venv/

# The voice chosen in a previous interactive run.
.voci-scelte.json

# Python and macOS leftovers.
__pycache__/
*.pyc
.DS_Store

# Scratch directory each writer uses to check its own chapter in isolation
books/*/content/.selfcheck/

# Generated: the quiz rebalance work lists, rebuilt by make_rebalance_lists.py
quiz-src/batches/*/*.rebalance.txt
# Generated: the quiz browser self-test page
quiz-src/test/selftest.html

# Vision tool artifacts
.dsh-vision-router/
# Generated: quiz preview page and raw (uncleaned) PDF text
quiz-src/test/preview.html
quiz-src/extract/raw*.txt
quiz-src/extract/p*.txt
